# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://salon:salon@localhost:5432/salon_dev
# Tests use their own database (wiped on every run):
TEST_DATABASE_URL=postgres://salon:salon@localhost:5432/salon_test

# Long random strings (e.g. `openssl rand -hex 32`).
JWT_SECRET=
OTP_HMAC_SECRET=

# Comma-separated origins allowed to call the API, or *.
CORS_ORIGINS=http://localhost:3001

# Public demo hosting without WhatsApp (see ../DEPLOY.md). Lets the dev providers run in production,
# shows the sign-in code on the website, and creates the demo salon on first start. Anyone can sign
# in as any phone number, so never use it with real customers.
# DEMO_MODE=true
# SEED_STAFF_PASSWORD=choose-a-password-of-8-or-more-characters

# Where sign-in codes and queue alerts go:
#   dev   = printed in this terminal (default; refused when NODE_ENV=production)
#   meta  = real WhatsApp through Meta's Cloud API (free test number; see README "WhatsApp via Meta")
#   vobiz = real WhatsApp through Vobiz
OTP_PROVIDER=dev
NOTIFY_PROVIDER=dev

# Meta WhatsApp Cloud API (needed when either provider above is 'meta').
# From developers.facebook.com → your app → WhatsApp → API Setup.
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v23.0
# Leave these empty to send plain text (fine for testing: message the test number "hi" first).
META_WA_TEMPLATE_LANGUAGE=en
META_WA_OTP_TEMPLATE=
META_WA_TURN_ALERT_TEMPLATE=
META_WA_CALLED_TEMPLATE=

# Vobiz WhatsApp (needed when either provider above is 'vobiz').
VOBIZ_API_BASE_URL=https://api.vobiz.ai/api/v1
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_CHANNEL_ID=
VOBIZ_WABA_ID=
VOBIZ_TEMPLATE_LANGUAGE=en
# Meta-approved template names:
VOBIZ_OTP_TEMPLATE=
VOBIZ_TURN_ALERT_TEMPLATE=
VOBIZ_CALLED_TEMPLATE=

# Optional tuning (defaults shown)
# OTP_TTL_SECONDS=300
# OTP_MAX_VERIFY_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_MAX_PER_HOUR=5
# CUSTOMER_TOKEN_TTL=30d
# STAFF_TOKEN_TTL=12h
# MAX_ACTIVE_ENTRIES_PER_CUSTOMER=1
# RATE_LIMIT_ENABLED=true
# SWEEP_INTERVAL_MS=30000
# SEED_STAFF_PASSWORD=salon-demo-1234
